{
  "name": "coaction-labs-hub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API backend for CO/ACTION AI Hub",
  "main": "dist/server.mjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node --watch --env-file=../.env --import tsx src/server.ts",
    "start": "node --env-file=../.env dist/server.mjs",
    "migrate": "node --env-file=../.env -e \"import('./dist/migrate.js')\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
