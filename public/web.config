<?xml version="1.0" encoding="utf-8"?>
<!--
  SPA fallback for the CO/ACTION AI Hub frontend (static files served by IIS).

  React Router routes such as /login/callback, /marketplace, etc. are NOT files
  on disk. A direct hit or a refresh on one of them makes IIS look for a
  physical path, find nothing, and return 404 — which is exactly the error seen
  on https://labs.coactionspecialty.com/login/callback?code=...&state=...

  This rewrites any request that is NOT an existing file or directory to
  /index.html, so the SPA boots and resolves the route client-side (including
  the Okta callback, whose ?code=&state= must reach okta-react to finish PKCE).

  IMPORTANT:
  * This is hosting config only — it introduces NO backend dependency. Login is
    pure browser-side PKCE against Okta. The /api passthrough below merely keeps
    IIS from rewriting API calls IF a backend is mounted there; with no backend,
    those paths are simply left untouched.
  * It must be a REWRITE, not a redirect, so the URL and ?code=&state= survive.
  * The host needs the IIS "URL Rewrite" module installed, otherwise IIS returns
    HTTP 500.19 (unknown <rewrite> section) instead of serving the app.

  Vite copies everything in /public verbatim into /dist, so this deploys to the
  site root automatically on every `npm run build`.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/api(/|$)" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Content-hashed bundle files are immutable per build → cache them hard. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>
  </system.webServer>

  <!--
    index.html must NEVER be cached, otherwise after a deploy users boot a stale
    bundle that can point at a previous Okta client_id / redirect URI — the
    "works only after a hard refresh" class of bugs.
  -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
