# CO/ACTION AI Hub — backend environment variables
# Copy to `.env` at the deploy root (D:\LabsHub\.env) and fill in values.
# Never commit a populated .env.

# --- Database (Aurora PostgreSQL) ---
# Cluster endpoint for the labs_platform database.
DB_HOST=
# Database name.
DB_NAME=labs_platform
# Database credentials.
DB_USER=
DB_PASSWORD=
# Postgres port (Aurora default).
DB_PORT=5432
# Require TLS to the cluster ("true" in all real environments).
DB_SSL=true
# Note: the connection search_path is set in code (server/src/constants/schemas.ts)
# to the Labs schemas: iam, catalog, runtime, engagement, analytics, governance,
# knowledge, collaboration, integration, audit, ops. There is no DB_SCHEMA env var.

# --- Auth (Okta SSO + JWT) ---
# Secret used to sign/verify the app session JWT.
JWT_SECRET=
# Okta OIDC authorization server issuer (e.g. https://<org>.okta.com/oauth2/default).
OKTA_ISSUER=
# Okta application client ID.
OKTA_CLIENT_ID=
# Okta application client secret.
OKTA_CLIENT_SECRET=
# Redirect URI registered on the Okta app; must match the SPA callback.
OKTA_REDIRECT_URI=
# Set "true" to bypass Okta and use a mock user (local dev only).
DISABLE_OKTA=false
